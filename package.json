{
  "name": "magik-harness",
  "version": "2.0.0",
  "type": "module",
  "description": "A harness for AI coding agents: a repo, a vault of knowledge and memory, and a few rules. One CLI installs it per project or per machine; works with Cursor, Claude Code, Codex and any agent that reads AGENTS.md.",
  "license": "MIT",
  "author": "LaLi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elendil-tech/magik-harness.git"
  },
  "homepage": "https://github.com/elendil-tech/magik-harness#readme",
  "bugs": {
    "url": "https://github.com/elendil-tech/magik-harness/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "harness",
    "knowledge-base",
    "memory",
    "agents-md",
    "agent-skills",
    "cursor",
    "claude-code",
    "codex",
    "cli"
  ],
  "bin": {
    "magik-harness": "bin/magik-harness.js"
  },
  "files": [
    "bin",
    "src",
    "runtime",
    "content",
    "skills",
    "packs",
    "commands",
    ".cursor-plugin",
    "assets/magik-harness-logo.png",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "tsc --noEmit && node scripts/run-tests.mjs",
    "install-plugin": "node scripts/install-plugin.mjs",
    "uninstall-plugin": "node scripts/install-plugin.mjs --uninstall"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
